{
  "name": "knowledge-nook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turns YouTube channels and websites into a public, cited knowledge site.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "css": "tailwindcss -i styles/input.css -o static/site.css --minify",
    "build": "tsx scripts/build.ts",
    "test": "node --import tsx --test --test-timeout=120000 test/*.test.mjs",
    "check": "node scripts/check.mjs all",
    "deploy": "npm run check && python3 ~/tools/taskandtool.py deploy dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@resvg/resvg-js": "^2.6.2",
    "d3-hierarchy": "^3.1.3",
    "hono": "^4.13.16",
    "marked": "^18.1.3",
    "satori": "^0.63.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "node-html-parser": "^9.0.7",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
